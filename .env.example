# Gmail SMTP + 앱 비밀번호 방식 (2026-09-17 확정)
# 1. Google 계정에서 2단계 인증을 켠다.
# 2. https://myaccount.google.com/apppasswords 에서 앱 비밀번호를 발급받는다.
# 3. 아래 값을 채운 뒤 파일명을 .env 로 바꾼다 (.env는 git에 올라가지 않음).

GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 수신자 목록 (콤마 구분, 데모용 기본값)
BRIEFING_RECIPIENTS=your-address@gmail.com

# 이메일의 "Biz Insight 바로가기" 버튼 링크. 비워두면 localhost:3000으로 기본 연결됨.
# 실제 배포 후에는 Vercel에서 발급된 실제 주소로 바꿀 것.
DASHBOARD_URL=http://localhost:3000/dashboard.html
